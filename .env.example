# SkillSetu environment defaults

# Production-ready PostgreSQL configuration (preferred for deployment)
DATABASE_URL=postgresql+psycopg://skillsetu:skillsetu@localhost:5432/skillsetu

# Local fallback for development/tests (SQLite is used automatically when DATABASE_URL is unset)
# DATABASE_URL=sqlite:///./skillsetu.db

SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development
APP_NAME=SkillSetu
